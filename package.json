{
  "name": "zaphood",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Office of Z.B. \u2014 an important homepage for an important visitor.",
  "homepage": "https://james-gibson.github.io/zaphood/",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/protected-manifest.mjs && tsc --noEmit && vite build && vite build --ssr scripts/prerender.tsx --outDir .prerender --emptyOutDir && node .prerender/prerender.js && node scripts/postbuild.mjs && node scripts/protect.mjs && node scripts/overflow.mjs && node scripts/verify-publish.mjs",
    "preview": "vite preview",
    "guard": "node scripts/verify-publish.mjs",
    "sync": "node scripts/sync-upstream.mjs",
    "manifest": "node scripts/protected-manifest.mjs",
    "protect": "node scripts/protect.mjs",
    "rules": "node scripts/sync-upstream.mjs --check",
    "rotation": "node scripts/rotation.mjs",
    "overflow": "node scripts/overflow.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.2.8",
    "@tabler/icons-react": "^3.51.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
